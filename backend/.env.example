# Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. MongoDB Atlas)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/qissa_db?retryWrites=true&w=majority
# Leave empty for automatic in-memory development database
MONGODB_URI=

# JWT Secrets for Admin
JWT_SECRET=qissa_arabic_restaurant_jwt_secure_key_2026_super_secret
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS & Socket.IO)
CLIENT_CUSTOMER_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174

# Cloudinary Storage (Optional for external image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
